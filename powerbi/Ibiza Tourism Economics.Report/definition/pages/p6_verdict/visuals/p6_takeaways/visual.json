    "visual":  {
                   "visualType":  "textbox",
                   "objects":  {
                                   "general":  [
                                                   {
                                                       "properties":  {
                                                                          "paragraphs":  [
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "A four-month economy",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "11pt",
                                                                                                                                        "color":  "#E8623F",
                                                                                                                                        "fontWeight":  "bold"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "Ibiza\u0027s hotels earn most of their year between June and September, when August brings over a hundred times January\u0027s foreign guests. That makes the island unusually exposed to any shock to the summer.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "9.5pt",
                                                                                                                                        "color":  "#0F2A3F"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  " ",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "4pt",
                                                                                                                                        "color":  "#0F2A3F"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "Demand is not the problem",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "11pt",
                                                                                                                                        "color":  "#E8623F",
                                                                                                                                        "fontWeight":  "bold"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "COVID erased four-fifths of the August trade in 2020, yet arrivals were back above 2019 by 2022 and have kept rising. People want to come to Ibiza.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "9.5pt",
                                                                                                                                        "color":  "#0F2A3F"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  " ",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "4pt",
                                                                                                                                        "color":  "#0F2A3F"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "But Ibiza is not the fullest",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "11pt",
                                                                                                                                        "color":  "#E8623F",
                                                                                                                                        "fontWeight":  "bold"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "In peak season Mallorca\u0027s resorts fill more of their beds. Inside Ibiza, San Antonio and Playa d\u0027en Bossa run level - full when it matters, but no fuller than their rivals.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "9.5pt",
                                                                                                                                        "color":  "#0F2A3F"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  " ",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "4pt",
                                                                                                                                        "color":  "#0F2A3F"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "The money is in the price",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "11pt",
                                                                                                                                        "color":  "#E8623F",
                                                                                                                                        "fontWeight":  "bold"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "With summer beds already full, growth since 2023 has come mostly from room rates, which have roughly doubled since 2014. The latest figures agree: in 2025 visitors spent a record €4.5bn on Ibiza and Formentera while their numbers rose just 1.2% (IBESTAT). A pricing story, not a crowding story.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "9.5pt",
                                                                                                                                        "color":  "#0F2A3F"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  " ",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "4pt",
                                                                                                                                        "color":  "#0F2A3F"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "What to watch",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "11pt",
                                                                                                                                        "color":  "#E8623F",
                                                                                                                                        "fontWeight":  "bold"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "Room rates here cover all four Balearic islands, and resort-level data only starts in 2024. As more years arrive, the key question is how far prices can keep rising before demand starts to fall.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "9.5pt",
                                                                                                                                        "color":  "#0F2A3F"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  " ",
