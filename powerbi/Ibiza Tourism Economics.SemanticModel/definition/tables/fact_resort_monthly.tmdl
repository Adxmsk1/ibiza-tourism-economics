	partition fact_resort_monthly = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Projects\ibiza-tourism-economics\data\processed\fact_resort_monthly.csv"), [Delimiter=",", Columns=18, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"resort", type text}, {"month_date", type date}, {"year", Int64.Type}, {"month", Int64.Type}, {"guests_domestic", type number}, {"guests_foreign", type number}, {"guests_total", type number}, {"nights_domestic", type number}, {"nights_foreign", type number}, {"nights_total", type number}, {"establishments", type number}, {"rooms", type number}, {"bed_places", type number}, {"occ_bedplaces_pct", type number}, {"occ_weekend_pct", type number}, {"occ_bedrooms_pct", type number}, {"staff", type number}, {"avg_length_of_stay_nights", type number}})
				in
				    #"Changed Type"

